cabal-version: 3.14
name: a400k
version: 0.1.0.0
-- synopsis:
-- description:
-- license:
-- license-file:
-- author:
-- maintainer:
-- copyright:
build-type: Simple
-- extra-doc-files:
-- extra-source-files:

common warnings
    ghc-options:
        -Wall
        -Wno-x-partial
        -Wno-missing-signatures
        -Wno-type-defaults
        -Wno-incomplete-patterns

library
    import: warnings
    exposed-modules: A400k
    -- other-modules:
    -- other-extensions:
    build-depends: base
    hs-source-dirs: src
    default-language: GHC2024

test-suite a400k-test
    import: warnings
    default-language: GHC2024
    -- other-modules:
    -- other-extensions:
    type: exitcode-stdio-1.0
    hs-source-dirs: test
    main-is: Main.hs
    build-depends:
        base,
        a400k
